# Anthropic API 키 (필수 — 콘텐츠 생성)
ANTHROPIC_API_KEY=
# 모델·사고 깊이 (선택 — 비우면 claude-opus-5-5 / high). 새 모델이 나오면 여기(Render 환경변수)만 바꿔도 된다.
# auto 로 두면 서버가 켜질 때 가장 새 Opus를 골라 쓴다. 비워 두면 새 Opus가 나왔을 때 화면에 알림만 뜬다.
CLAUDE_MODEL=
CLAUDE_EFFORT=

# Vimeo API 액세스 토큰 (필수 — 자막 수집)
VIMEO_ACCESS_TOKEN=

# Instagram Graph API (보이스 프로파일 학습용)
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=

# Supabase (선택 — 비우면 로컬 파일 저장으로 자동 폴백)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 서버 포트 (기본 3000)
PORT=3000
